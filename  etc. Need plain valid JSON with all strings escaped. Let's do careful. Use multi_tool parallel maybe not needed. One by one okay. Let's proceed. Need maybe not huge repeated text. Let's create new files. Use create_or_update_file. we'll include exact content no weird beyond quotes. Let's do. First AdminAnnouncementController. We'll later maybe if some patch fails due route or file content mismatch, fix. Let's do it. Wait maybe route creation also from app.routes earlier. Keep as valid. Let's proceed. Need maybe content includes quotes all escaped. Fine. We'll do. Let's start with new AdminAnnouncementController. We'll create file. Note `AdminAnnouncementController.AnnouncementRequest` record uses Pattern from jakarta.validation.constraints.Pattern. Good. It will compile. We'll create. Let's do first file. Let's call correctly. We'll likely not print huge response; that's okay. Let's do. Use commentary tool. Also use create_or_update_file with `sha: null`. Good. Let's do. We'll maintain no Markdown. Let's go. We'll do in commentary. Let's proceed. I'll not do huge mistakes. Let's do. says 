import { DatePipe } from '@angular/common';
import { Component, OnInit, inject, signal } from '@angular/core';
import { RouterLink } from '@angular/router';
import { StudentApiService } from '../../../core/services/student-api.service';
import { StudentFeedItem } from '../../../shared/models/student.model';

@Component({
  selector: 'app-student-feed',
  standalone: true,
  imports: [DatePipe, RouterLink],
  template: `
    <header><p class="eyebrow">VOTRE ESPACE</p><h1>Fil d'actualités</h1><p>Les annonces, séances et échéances de vos cours réunies au même endroit.</p></header>
    @if (loading()) { <p role="status">Chargement du fil…</p> }
    @if (error()) { <p class="error" role="alert">{{ error() }}</p> }
    @if (!loading() && items().length===0) { <section class="empty"><h2>Rien de nouveau pour le moment</h2><p>Les prochaines actualités de vos cours apparaîtront ici.</p></section> }
    <section class="feed">
      @for (item of items(); track item.type + '-' + item.id) {
        <article>
          <div class="type" [class.session]="item.type==='SESSION'" [class.assignment]="item.type==='ASSIGNMENT'">
            {{ item.type==='ANNOUNCEMENT' ? 'ANNONCE' : item.type==='SESSION' ? 'SÉANCE' : 'ÉCHÉANCE' }}
          </div>
          <div class="body"><small>{{ item.courseTitle || 'ClassFlow' }}</small><h2>{{ item.title }}</h2>
            @if (item.description) { <p>{{ item.description }}</p> }
            <footer><time>{{ item.date | date:'EEEE d MMMM, HH:mm' }}</time><a [routerLink]="item.link">Consulter →</a></footer>
          </div>
        </article>
      }
    </section>
  `,
  styles: [`:host{display:block;max-width:1000px;margin:auto;color:#172033}header{margin-bottom:24px}h1{font-size:2rem;margin:5px 0}.eyebrow{font-size:.72rem;letter-spacing:.12em;color:#63809e;font-weight:700}.feed{display:grid;gap:18px}.type{display:inline-flex;align-items:center;padding:6px 10px;border-radius:999px;font-size:.72rem;font-weight:800;letter-spacing:.06em}.type.session{background:#eaf5ff;color:#205c96}.type.assignment{background:#fef4e8;color:#9a5f00}.body{padding:18px;border:1px solid #e9ecf5;border-radius:16px;background:#fff;box-shadow:0 10px 28px rgba(59,69,98,.04)}.body small{display:block;margin-bottom:8px;color:#66708d}.body h2{margin:0 0 8px;font-size:1.3rem}.body p{margin:0 0 12px;color:#3d4766;line-height:1.55}footer{display:flex;justify-content:space-between;gap:12px;align-items:center;color:#68768f;font-size:.82rem}.error{color:#b93030}.empty{padding:24px;border-radius:16px;border:1px dashed #dfe4f0;background:#fafbff}`]
})
export class FeedComponent implements OnInit {
  private readonly api = inject(StudentApiService);
  readonly items = signal<StudentFeedItem[]>([]);
  readonly loading = signal(true);
  readonly error = signal('');
  ngOnInit() {
    this.api.feed().subscribe({
      next: items => this.items.set(items),
      error: () => { this.error.set('Le fil d’actualités est momentanément indisponible.'); this.loading.set(false); },
      complete: () => this.loading.set(false)
    });
  }
}














































































































































































































































































































          






















































































